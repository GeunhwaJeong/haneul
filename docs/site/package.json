    "@graphql-tools/graphql-file-loader": "^8.1.18",
    "@mdx-js/react": "3.1.0",
    "@mui/material": "^5.18.0",
    "@plausible-analytics/tracker": "^0.4.5",
    "afdocs": "^0.3.4",
    "algoliasearch": "^5.56.0",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "copy-text-to-clipboard": "^3.2.2",
    "docusaurus-plugin-copy-page-button": "^0.3.5",
    "docusaurus-theme-github-codeblock": "^2.0.2",
    "dotenv": "^16.6.1",
    "glob": "^11.1.0",
    "graphql": "^16.14.2",
    "graphql-config": "^5.1.6",
    "gray-matter": "^4.0.3",
    "hast-util-is-element": "^1.1.0",
    "he": "^1.2.0",
    "lodash": "^4.18.1",
    "markdown-it": "^14.3.0",
    "markdown-to-jsx": "^7.7.17",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "postcss": "^8.5.26",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "pure-react-carousel-thumbs": "^1.0.6",
    "pushfeedback": "^0.1.85",
    "pushfeedback-react": "^0.1.76",
    "raw-loader": "^4.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-instantsearch": "^7.42.0",
    "react-lite-youtube-embed": "^2.6.0",
    "react-scrollspy-navigation": "^1.0.3",
    "react-syntax-highlighter": "^15.6.6",
    "react-ui-scrollspy": "^2.3.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.19",
    "turndown": "^7.2.4",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@docusaurus/core": "3.9.2",
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@docusaurus/remark-plugin-npm2yarn": "3.9.2",
    "@docusaurus/theme-classic": "3.9.2",
    "@docusaurus/theme-common": "3.9.2",
    "@docusaurus/theme-mermaid": "3.9.2",
    "@docusaurus/theme-search-algolia": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "@mdx-js/react": "3.1.0",
    "@tsconfig/docusaurus": "^1.0.7",
    "@types/webpack-env": "^1.18.8",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "remark-parse": "^11.0.0",
    "typescript": "^4.9.5",
    "unified": "^11.0.5"
  },
  "resolutions": {
    "graphql": "^16.8.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "20",
    "pnpm": "9"
  },
  "pnpm": {
    "overrides": {
      "@docusaurus/*": "3.9.2",
      "prismjs@<1.30.0": ">=1.30.0",
      "webpack-dev-server@<=5.2.0": ">=5.2.1",
      "webpack": "5.103.0"
    }
  }
}
