{
  "name": "haneul-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "update-cli-docs": "node src/shared/js/update-cli-output.js",
    "prebuild": "node scripts/fetch-external-docs.js --force; node scripts/transform-external-docs.js; node scripts/generate-skills.mjs; node scripts/generate-import-context.js; node scripts/generate-resolved-pages.js; node scripts/convert-awesome-haneul.mjs; node scripts/convert-awesome-haneul-gaming.mjs",
    "prestart": "node scripts/fetch-external-docs.js; node scripts/transform-external-docs.js; node scripts/generate-skills.mjs; node scripts/convert-awesome-haneul.mjs;  node scripts/convert-awesome-haneul-gaming.mjs",
    "start": "rm -r ../content/references/framework; node scripts/grpc-download.js; docusaurus graphql-to-doc:beta && node scripts/remove-no-desc.mjs ../content/references/haneul-api/haneul-graphql/beta/reference; node scripts/getopenrpcspecs.js; node scripts/massagegraphql.js; docusaurus start",
    "build": "bash scripts/build-and-check.sh",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "node scripts/serve-with-rewrites.js",
    "serve:docusaurus": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "fire:deploy-dev": "firebase deploy --only hosting:dev",
    "ampli": "ampli",
    "test:markdown": "node scripts/test-markdown-export.js"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.45.5",
    "@docusaurus/plugin-content-docs": "3.9.2",
