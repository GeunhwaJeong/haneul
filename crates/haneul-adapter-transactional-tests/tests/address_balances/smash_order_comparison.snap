//> 2: haneul::balance::send_funds<haneul::haneul::HANEUL>(Result(1), Input(1));
mutated: object(0,0)
accumulators_written: (object(1,0), A, haneul::balance::Balance<haneul::haneul::HANEUL>, Merge, 100000000000)
